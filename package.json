{
  "name": "@toniadreal/dataquest-task-lifecycle",
  "version": "0.1.0",
  "description": "Task lifecycle state machine for a two-sided data marketplace (reproduced from the DataQuest portfolio case study)",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "bench": "npm run build && node dist/bench/bench.js",
    "build": "tsc",
    "demo": "npm run build && node dist/src/demo.js",
    "diagram": "npm run build && node dist/src/diagram.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "task-lifecycle",
    "state-machine",
    "event-sourcing",
    "sla",
    "webhooks",
    "payments",
    "typescript",
    "zero-dependency"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToniAdreal/dataquest-task-lifecycle.git"
  },
  "files": [
    "dist"
  ]
}
